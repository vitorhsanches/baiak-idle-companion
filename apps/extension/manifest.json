{
  "manifest_version": 3,
  "name": "Baiak Idle Companion",
  "description": "Local action assistant for Baiak Idle.",
  "version": "0.1.0",
  "permissions": ["sidePanel", "storage"],
  "content_scripts": [{
    "matches": ["https://baiakidle.com/jogar", "https://baiakidle.com/jogar/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "side_panel": { "default_path": "index.html" },
  "action": { "default_title": "Open Baiak Idle Companion" }
}
